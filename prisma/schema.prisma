datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CATALOGER
  APPROVER
  ADMIN
}

enum ProductStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  role     Role   @default(CATALOGER)
}

model Product {
  id                     String        @id @default(uuid())
  name                   String
  category               String
  type                   String
  baseMetalWeightGrams   Float
  manufacturingLabor     Float
  imageUrl               String?       @default("")
  allowedChainLengths    String        @default("[]")
  allowedDiamondShapes   String        @default("[]")
  allowedDiamondOrigins  String        @default("[]")
  allowedCaratWeights    String        @default("[]")
  allowedClarities       String        @default("[]")
  allowedColours         String        @default("[]")
  allowedCutGrades       String        @default("[]")
  allowedCertificates    String        @default("[]")
  status                 ProductStatus @default(DRAFT)
  rejectionReason        String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
}

model Metal {
  id           String @id @default(uuid())
  name         String @unique
  pricePerGram Float
}

model Diamond {
  id       String @id @default(uuid())
  shape    String
  carat    Float
  baseCost Float
}

model PricingRules {
  id                     Int   @id @default(1)
  retailMarkupPercentage Float @default(40.0)
  logisticsFee           Float @default(50.0)
  packagingFee           Float @default(15.0)
}